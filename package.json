{
  "name": "porto-vue",
  "version": "1.0.1",
  "description": "Porto - Multi-purpose Ecommerce template with Vue.js",
  "author": "d-themes",
  "private": true,
  "scripts": {
    "dev": "nuxt",
    "build": "nuxt build",
    "start": "SET NODE_OPTIONS=--openssl-legacy-provider && nuxt start",
    "lint": "eslint **/*.{js,vue} --color",
    "generate": "nuxt generate",
    "generate-mock": "babel-node api/generateMock.js --color",
    "preserve-mock": "npm run generate-mock",
    "serve-mock": "json-server mock_data/db.json --port 4001 --routes api/routes.json --color",
    "watch": "nuxt --watch"
  },
  "devDependencies": {
    "@babel/core": "7.18.13",
    "@babel/preset-env": "^7.18.10",
    "@nuxtjs/auth": "4.9.1",
    "autoprefixer": "^9.8.8",
    "eslint": "8.22.0",
    "eslint-config-rapida": "1.3.2",
    "eslint-plugin-vue": "9.4.0",
    "postcss": "^7.0.39",
    "postcss-import": "^12.0.1",
    "vue-template-compiler": "2.7.16"
  },
  "dependencies": {
    "@nuxt/image": "^0.7.1",
    "@nuxt/types": "2.15.8",
    "@nuxtjs/axios": "^5.13.6",
    "@nuxtjs/dotenv": "1.4.1",
    "@nuxtjs/google-gtag": "^1.0.4",
    "@nuxtjs/style-resources": "1.2.1",
    "@popperjs/core": "^2.11.8",
    "axios": "0.21.1",
    "axios-cache-adapter": "2.7.3",
    "bootstrap": "^5.3.3",
    "compression": "^1.8.1",
    "cookie-universal-nuxt": "^2.2.2",
    "lru-cache": "^6.0.0",
    "mobile-detect": "^1.4.5",
    "nuxt": "2.18.1",
    "nuxt-i18n": "^6.28.1",
    "nuxt-precompress": "^0.5.9",
    "sass": "1.32.8",
    "sass-loader": "^10.4.1",
    "vue": "2.7.16",
    "vue-good-table": "^2.21.11",
    "vue-js-modal": "^2.0.1",
    "vue-notification": "1.3.20",
    "vue-observe-visibility": "^1.0.0",
    "vue-progressbar": "^0.7.5",
    "vue-slide-toggle": "1.1.1",
    "vue-ssr-carousel": "^2.5.0",
    "vue2-flip-countdown": "^1.0.0",
    "webpack": "4.46.0"
